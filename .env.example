# ─────────────────────────────────────────────
# VEPARI AI — Environment Configuration Example
# Copy to .env.development / .env.staging / .env.production
# NEVER commit files with real values.
# ─────────────────────────────────────────────

# App environment: development | staging | production
APP_ENV=development

# ── Backend API ──────────────────────────────
# Public URL of the backend API (no trailing slash)
BACKEND_API_URL=https://api.dev.vepari.ai

# ── Authentication ────────────────────────────
# JWT secret lives SERVER-SIDE ONLY — never in mobile bundle
# JWT_SECRET=<server-side only, set in backend .env>
# JWT_REFRESH_SECRET=<server-side only>

# ── Database (server-side only) ───────────────
# DATABASE_URL=<server-side only>
# REDIS_URL=<server-side only>

# ── AI Gateway (server-side only) ─────────────
# All AI provider keys stay BEHIND the AI Gateway, never client-side.
# SARVAM_API_KEY=<server-side only>
# OPENAI_API_KEY=<server-side only>
# ANTHROPIC_API_KEY=<server-side only>

# ── Storage (server-side only) ────────────────
# S3_BUCKET=<server-side only>
# S3_REGION=<server-side only>
# S3_ACCESS_KEY=<server-side only>
# S3_SECRET_KEY=<server-side only>

# ── Push Notifications ────────────────────────
# FCM_SERVER_KEY=<server-side only>

# ── Feature flags ─────────────────────────────
FEATURE_VOICE_ENABLED=true
FEATURE_AI_ACTIONS_ENABLED=true
FEATURE_OFFLINE_MODE_ENABLED=true

# ── Sentry (public DSN is safe client-side) ───
SENTRY_DSN=
