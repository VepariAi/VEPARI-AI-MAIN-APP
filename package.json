{
  "name": "vepari-ai",
  "private": true,
  "version": "0.1.0",
  "description": "Vepari AI — Business OS for Indian SMBs",
  "workspaces": [
    "packages/*",
    "mobile",
    "backend"
  ],
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "dev:mobile": "npm run dev --workspace=mobile",
    "dev:backend": "npm run dev --workspace=backend",
    "clean": "turbo run clean && rm -rf node_modules"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.4.5"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
