// Vepari AI — Prisma Schema
// All monetary amounts stored as paise (integer, never float)
// Language-independent: UI language is a user preference, not a data property

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ── Enums ────────────────────────────────────────────────────────────────────

enum UserRole {
  OWNER
  MANAGER
  STAFF
}

enum BusinessType {
  RETAIL
  RESTAURANT
  SERVICES
  MANUFACTURING
  DISTRIBUTION
  OTHER
}

enum TransactionType {
  SALE
  EXPENSE
  PURCHASE
  PAYMENT
  CREDIT_ISSUED
  CREDIT_RECEIVED
}

enum PaymentMethod {
  CASH
  UPI
  CARD
  BANK_TRANSFER
  CREDIT
}

enum OtpPurpose {
  LOGIN
  REGISTER
  CHANGE_PHONE
}

enum SyncStatus {
  PENDING
  SYNCED
  CONFLICT
  FAILED
}

// ── Identity Domain ──────────────────────────────────────────────────────────

model User {
  id         String   @id @default(uuid())
  phone      String   @unique
  name       String
  language   String   @default("en")
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Relations
  businessMembers BusinessMember[]
  refreshTokens   RefreshToken[]
  auditLogs       AuditLog[]
  voiceQueries    VoiceQuery[]

  @@map("users")
}

model OtpCode {
  id        String     @id @default(uuid())
  phone     String
  code      String
  purpose   OtpPurpose
  expiresAt DateTime
  usedAt    DateTime?
  attempts  Int        @default(0)
  createdAt DateTime   @default(now())

  @@index([phone, purpose])
  @@map("otp_codes")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ── Business Domain ──────────────────────────────────────────────────────────

model Business {
  id          String       @id @default(uuid())
  name        String
  type        BusinessType @default(RETAIL)
  gstNumber   String?
  phone       String
  addressLine1 String?
  addressLine2 String?
  city        String?
  state       String?
  pincode     String?
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  // Relations
  members     BusinessMember[]
  customers   Customer[]
  suppliers   Supplier[]
  products    Product[]
  transactions Transaction[]
  salesOrders  SaleOrder[]
  expenses     Expense[]
  purchases    Purchase[]
  documents    Document[]
  voiceQueries VoiceQuery[]
  bankStatementImports BankStatementImport[]

  @@map("businesses")
}

model BusinessMember {
  id         String   @id @default(uuid())
  businessId String
  userId     String
  role       UserRole @default(STAFF)
  joinedAt   DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([businessId, userId])
  @@map("business_members")
}

// ── Core Business Domain ─────────────────────────────────────────────────────

model Customer {
  id          String   @id @default(uuid())
  businessId  String
  name        String
  phone       String?
  email       String?
  // Credit balance in paise (positive = customer owes us, negative = we owe them)
  creditBalance Int    @default(0)
  notes       String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  syncStatus  SyncStatus @default(PENDING)
  syncedAt    DateTime?

  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  saleOrders   SaleOrder[]
  transactions Transaction[]

  @@index([businessId])
  @@map("customers")
}

model Supplier {
  id           String   @id @default(uuid())
  businessId   String
  name         String
  phone        String?
  email        String?
  // Payable balance in paise (positive = we owe them, negative = they owe us)
  payableBalance Int    @default(0)
  notes        String?
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  syncStatus   SyncStatus @default(PENDING)
  syncedAt     DateTime?

  business    Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  purchases   Purchase[]
  transactions Transaction[]

  @@index([businessId])
  @@map("suppliers")
}

model Product {
  id                String   @id @default(uuid())
  businessId        String
  name              String
  sku               String?
  // Price in paise
  priceInPaise      Int      @default(0)
  // Cost price in paise
  costPriceInPaise  Int      @default(0)
  stock             Int      @default(0)
  unit              String   @default("unit")
  lowStockThreshold Int?
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  syncStatus        SyncStatus @default(PENDING)
  syncedAt          DateTime?

  business       Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  saleOrderItems SaleOrderItem[]
  purchaseItems  PurchaseItem[]

  @@index([businessId])
  @@map("products")
}

// ── Transactions Domain ──────────────────────────────────────────────────────

model Transaction {
  id            String          @id @default(uuid())
  businessId    String
  customerId    String?
  supplierId    String?
  type          TransactionType
  // Amount in paise
  amountInPaise Int
  description   String?
  notes         String?
  date          DateTime
  paymentMethod PaymentMethod   @default(CASH)
  referenceId   String?         // invoice/order id
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  syncStatus    SyncStatus      @default(PENDING)
  syncedAt      DateTime?

  business  Business  @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer  Customer? @relation(fields: [customerId], references: [id])
  supplier  Supplier? @relation(fields: [supplierId], references: [id])
  bankStatementEntries BankStatementEntry[]

  @@index([businessId, date])
  @@index([businessId, type])
  @@map("transactions")
}

model SaleOrder {
  id              String        @id @default(uuid())
  businessId      String
  customerId      String?
  // Total in paise
  totalInPaise    Int
  // Tax in paise
  taxInPaise      Int           @default(0)
  // Discount in paise
  discountInPaise Int           @default(0)
  paymentMethod   PaymentMethod @default(CASH)
  status          String        @default("completed")
  notes           String?
  date            DateTime
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  syncStatus      SyncStatus    @default(PENDING)
  syncedAt        DateTime?

  business Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customer Customer?       @relation(fields: [customerId], references: [id])
  items    SaleOrderItem[]

  @@index([businessId, date])
  @@map("sale_orders")
}

model SaleOrderItem {
  id            String @id @default(uuid())
  saleOrderId   String
  productId     String
  quantity      Int
  // Unit price in paise at time of sale
  unitPriceInPaise Int
  // Total for this line in paise
  totalInPaise  Int

  saleOrder SaleOrder @relation(fields: [saleOrderId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id])

  @@map("sale_order_items")
}

model Expense {
  id            String        @id @default(uuid())
  businessId    String
  category      String
  // Amount in paise
  amountInPaise Int
  description   String?
  notes         String?
  date          DateTime
  paymentMethod PaymentMethod @default(CASH)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  syncStatus    SyncStatus    @default(PENDING)
  syncedAt      DateTime?

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, date])
  @@map("expenses")
}

model Purchase {
  id              String        @id @default(uuid())
  businessId      String
  supplierId      String?
  // Total in paise
  totalInPaise    Int
  // Tax in paise
  taxInPaise      Int           @default(0)
  paymentMethod   PaymentMethod @default(CASH)
  status          String        @default("completed")
  notes           String?
  date            DateTime
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  syncStatus      SyncStatus    @default(PENDING)
  syncedAt        DateTime?

  business  Business       @relation(fields: [businessId], references: [id], onDelete: Cascade)
  supplier  Supplier?      @relation(fields: [supplierId], references: [id])
  items     PurchaseItem[]

  @@index([businessId, date])
  @@map("purchases")
}

model PurchaseItem {
  id           String @id @default(uuid())
  purchaseId   String
  productId    String
  quantity     Int
  // Unit cost in paise
  unitCostInPaise Int
  // Total for this line in paise
  totalInPaise Int

  purchase Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product  Product  @relation(fields: [productId], references: [id])

  @@map("purchase_items")
}

// ── AI / Voice Domain ────────────────────────────────────────────────────────

model VoiceQuery {
  id          String   @id @default(uuid())
  businessId  String
  userId      String
  transcript  String
  language    String
  intent      String?
  entities    Json?
  response    String?
  actionTaken String?
  processingMs Int?
  createdAt   DateTime @default(now())

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])

  @@index([businessId])
  @@map("voice_queries")
}

// ── Documents ────────────────────────────────────────────────────────────────

model Document {
  id         String   @id @default(uuid())
  businessId String
  type       String   // invoice, receipt, purchase_order, etc.
  title      String
  url        String?
  metadata   Json?
  date       DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId])
  @@map("documents")
}

// ── Audit ─────────────────────────────────────────────────────────────────────

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  resource   String
  resourceId String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([resource, resourceId])
  @@map("audit_logs")
}

// ── Bank Reconciliation ───────────────────────────────────────────────────────

model BankStatementImport {
  id         String   @id @default(uuid())
  businessId String
  label      String
  importedAt DateTime @default(now())

  business Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  entries  BankStatementEntry[]

  @@index([businessId])
  @@map("bank_statement_imports")
}

model BankStatementEntry {
  id            String    @id @default(uuid())
  importId      String
  date          DateTime
  // Positive = credit to account (money in), negative = debit (money out) — paise
  amountInPaise Int
  description   String?
  reference     String?
  // Null means unmatched
  matchedTransactionId String?
  matchedAt            DateTime?

  import             BankStatementImport @relation(fields: [importId], references: [id], onDelete: Cascade)
  matchedTransaction Transaction?        @relation(fields: [matchedTransactionId], references: [id])

  @@index([importId])
  @@map("bank_statement_entries")
}

// ── Sync ──────────────────────────────────────────────────────────────────────

model SyncCheckpoint {
  id          String   @id @default(uuid())
  businessId  String
  deviceId    String
  lastSyncAt  DateTime
  checkpoint  Json

  @@unique([businessId, deviceId])
  @@map("sync_checkpoints")
}
