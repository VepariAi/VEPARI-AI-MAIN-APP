# ─────────────────────────────────────────────────────────────────────────────
# Vepari AI — Backend Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to Git. All secrets stay server-side; see CLAUDE.md §Security.
# ─────────────────────────────────────────────────────────────────────────────

# ── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
API_VERSION=v1

# ── Database (MySQL via Prisma) ──────────────────────────────────────────────
# Format: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=mysql://vepari:changeme@localhost:3306/vepari_dev

# ── JWT Authentication ────────────────────────────────────────────────────────
# Access tokens: 15 min. Refresh tokens: 90 days. Both signed with this secret.
# Generate a strong random value: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_USE_A_STRONG_RANDOM_SECRET_AT_LEAST_64_CHARS

# ── OTP / SMS (Indian phone numbers, E.164 format) ───────────────────────────
# Provider used for OTP delivery. Replace with your actual SMS gateway credentials.
SMS_PROVIDER=twilio
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=CHANGE_ME
TWILIO_FROM_NUMBER=+1234567890

# ── AI Gateway (Sarvam AI — server-side only, never client-side) ──────────────
# All Sarvam STT/TTS and LLM calls go through the AI module; keys never leave the server.
SARVAM_API_KEY=CHANGE_ME
SARVAM_API_URL=https://api.sarvam.ai

# ── OpenAI (via AI Gateway — never exposed to mobile) ────────────────────────
OPENAI_API_KEY=CHANGE_ME
OPENAI_MODEL=gpt-4o-mini

# ── Anthropic (via AI Gateway — never exposed to mobile) ─────────────────────
ANTHROPIC_API_KEY=CHANGE_ME
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. In production lock to your actual domains.
CORS_ORIGINS=http://localhost:8081,http://localhost:3001

# ── Rate limiting (ThrottlerModule) ──────────────────────────────────────────
THROTTLE_TTL_SECONDS=60
THROTTLE_LIMIT=100

# ── Redis (optional — for caching, rate-limit state, SSE scaling) ─────────────
# Leave blank if not using Redis in local dev.
REDIS_URL=

# ── Storage (documents, receipts) ────────────────────────────────────────────
# S3-compatible object storage. Use MinIO locally.
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=vepari-docs
STORAGE_ACCESS_KEY=CHANGE_ME
STORAGE_SECRET_KEY=CHANGE_ME
STORAGE_REGION=ap-south-1

# ── Audit & Logging ───────────────────────────────────────────────────────────
LOG_LEVEL=debug

# ── Billing (Razorpay) ────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=CHANGE_ME
RAZORPAY_KEY_SECRET=CHANGE_ME

# ─────────────────────────────────────────────────────────────────────────────
# Security checklist before production:
#   - Use a unique, randomly-generated JWT_SECRET (64+ chars)
#   - Rotate all CHANGE_ME values
#   - Restrict CORS_ORIGINS to production domains only
#   - Enable SSL on the database connection (append ?sslmode=require)
#   - Set NODE_ENV=production
# ─────────────────────────────────────────────────────────────────────────────
